#cloud-config
# Build-time only — image-factory Packer provisioner. Do not use as production user-data.
# Keep packages minimal so SSH is up before apt finishes; install-k8s.sh waits on cloud-init.
users:
  - name: ubuntu
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    plain_text_passwd: "virtfoundry-build"
chpasswd:
  list: |
    ubuntu:virtfoundry-build
  expire: false
ssh_pwauth: true
package_update: false
packages:
  - qemu-guest-agent
runcmd:
  - systemctl enable --now qemu-guest-agent || true
